generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      String // "owner" or "vet"
  phone     String?
  pets      Pet[]    @relation("OwnerPets")
  reports   Report[] @relation("VetReports")
  createdAt DateTime @default(now())
}

model Pet {
  id          String          @id @default(cuid())
  ownerId     String
  owner       User            @relation("OwnerPets", fields: [ownerId], references: [id])
  name        String
  breed       String
  species     String
  age         Int
  height      Float
  weight      Float
  photoUrl    String?
  publicNotes String?
  qrCode      String          @unique
  isLost      Boolean         @default(false)
  lastLat     Float?
  lastLng     Float?
  lastSeenAt  DateTime?
  reports     Report[]
  scanLogs    ScanLog[]
  messages    FinderMessage[]
  createdAt   DateTime        @default(now())
}

model Report {
  id               String    @id @default(cuid())
  petId            String
  pet              Pet       @relation(fields: [petId], references: [id], onDelete: Cascade)
  vetId            String
  vet              User      @relation("VetReports", fields: [vetId], references: [id])
  rawNotes         String
  summary          String
  diagnosis        String?
  medication       String?
  careInstructions String?
  aiSummarized     Boolean   @default(false)
  nextVisit        DateTime?
  createdAt        DateTime  @default(now())
}

model ScanLog {
  id        String   @id @default(cuid())
  petId     String
  pet       Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
  lat       Float?
  lng       Float?
  scannedAt DateTime @default(now())
}

model FinderMessage {
  id        String   @id @default(cuid())
  petId     String
  pet       Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
  name      String?
  contact   String?
  message   String
  lat       Float?
  lng       Float?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([petId, createdAt])
}
