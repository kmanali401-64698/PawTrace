generator client {
  provider   = "prisma-client"
  output     = "../app/generated/prisma"
  // Rust-free client: queries go through the `pg` driver (lib/prisma.ts), so there is
  // no native query-engine file to ship (Vercel failed to bundle it).
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String         @id @default(cuid())
  email     String         @unique
  password  String
  name      String
  role      String // "owner" or "vet"
  phone     String?
  clinic    String? // vets only: clinic / hospital name shown to owners
  pets      Pet[]          @relation("OwnerPets")
  reports   Report[]       @relation("VetReports")
  vetAccess PetVetAccess[] @relation("AccessVet")
  referrals PetVetAccess[] @relation("AccessReferrer")
  createdAt DateTime       @default(now())
}

model Pet {
  id          String          @id @default(cuid())
  ownerId     String
  owner       User            @relation("OwnerPets", fields: [ownerId], references: [id])
  name        String
  breed       String
  species     String
  age         Int
  height      Float
  weight      Float
  photoUrl    String?
  publicNotes String?
  qrCode      String          @unique
  isLost      Boolean         @default(false)
  lastLat     Float?
  lastLng     Float?
  lastSeenAt  DateTime?
  reports     Report[]
  scanLogs    ScanLog[]
  messages    FinderMessage[]
  vetAccess   PetVetAccess[]
  createdAt   DateTime        @default(now())
}

model Report {
  id               String    @id @default(cuid())
  petId            String
  pet              Pet       @relation(fields: [petId], references: [id], onDelete: Cascade)
  vetId            String
  vet              User      @relation("VetReports", fields: [vetId], references: [id])
  rawNotes         String
  summary          String
  diagnosis        String?
  medication       String?
  careInstructions String?
  aiSummarized     Boolean   @default(false)
  nextVisit        DateTime?
  createdAt        DateTime  @default(now())
}

model ScanLog {
  id        String   @id @default(cuid())
  petId     String
  pet       Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
  lat       Float?
  lng       Float?
  scannedAt DateTime @default(now())
}

model FinderMessage {
  id        String   @id @default(cuid())
  petId     String
  pet       Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
  name      String?
  contact   String?
  message   String
  lat       Float?
  lng       Float?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([petId, createdAt])
}

// Which vets may see a pet's medical history and add reports. The owner decides:
// vets request access (pending) and the owner approves/denies; owners can add a vet
// directly; a vet who already has access can refer the pet to another vet. The owner
// can revoke any vet at any time.
model PetVetAccess {
  id           String    @id @default(cuid())
  petId        String
  pet          Pet       @relation(fields: [petId], references: [id], onDelete: Cascade)
  vetId        String
  vet          User      @relation("AccessVet", fields: [vetId], references: [id], onDelete: Cascade)
  status       String // "pending" | "approved" | "denied" | "revoked"
  source       String // "request" (vet asked) | "owner" (owner added) | "referral" (another vet referred)
  referredById String?
  referredBy   User?     @relation("AccessReferrer", fields: [referredById], references: [id], onDelete: SetNull)
  note         String?
  createdAt    DateTime  @default(now())
  decidedAt    DateTime?

  @@unique([petId, vetId])
  @@index([vetId, status])
}
